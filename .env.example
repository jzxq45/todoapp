# === FILE: .env.example ===
# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s

# Database configuration
# Options: memory (resets at restart) or sqlite (persistent)
DB_DRIVER=memory
# For sqlite: path to database file. Parent directories are created automatically.
DB_DSN=todo.db

# Logging configuration
# Level: debug, info, warn, error
LOG_LEVEL=info
# Format: json, text
LOG_FORMAT=json